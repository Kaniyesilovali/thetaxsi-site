# TheTaxsi — sunucu ayarları. Bu dosya build ile dist/ içine kopyalanır ve
# deploy sırasında sunucuya gider. Sunucuda elle düzenleme — burada düzenle.

# ---------- Dizin listelemeyi kapat ----------
# Olmadan /assets/ gibi klasörler herkese açık dosya listesi gösterir.
Options -Indexes

# ---------- Kendi 404 sayfamız ----------
ErrorDocument 404 /404.html

# ---------- Yönlendirmeler ----------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www → www'suz, doğrudan https'e (kopya içerik olmasın, canonical ile aynı adres kalsın)
  # Sertifika kurulu (Cloudflare); http hedefi üç adımlı zincir üretiyordu:
  # https://www → http:// → https://  — ortadaki adım hem şifresizdi hem link değeri yiyordu.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # HTTPS zorunlu. Cloudflare "Always Use HTTPS" zaten yükseltiyor; bu blok
  # origin'e doğrudan gelen http istekleri için ikinci savunma hattı.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Kök adres → dil sürümü, sunucu tarafında. Önceden bunu dist/index.html
  # yapıyordu: noindex + meta refresh. Google onu "noindex ile hariç tutuldu"
  # diye raporluyordu — yani thetaxsi.com kök adresi hiç dizine girmiyor ve
  # köke gelen link değeri /en/'e akmıyordu. 302 ile artık "yönlendirmesi olan
  # sayfa" olarak görülüyor. Googlebot Accept-Language göndermez → /en/'e düşer.
  RewriteCond %{HTTP:Accept-Language} ^tr [NC]
  RewriteRule ^$ /tr/ [R=302,L]
  RewriteCond %{HTTP:Accept-Language} ^ru [NC]
  RewriteRule ^$ /ru/ [R=302,L]
  RewriteRule ^$ /en/ [R=302,L]
</IfModule>

# ---------- Sıkıştırma ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------- Tarayıcı önbelleği ----------
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML: önbelleğe alma — deploy sonrası değişiklikler anında görünsün.
  ExpiresByType text/html "access plus 0 seconds"

  # Varlıklar: uzun süre. Dosya adları sabit olduğu için CSS/JS güncellemesinde
  # kullanıcı eskiyi görebilir; bu yüzden bir haftada tutuluyor, bir yıl değil.
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"

  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ---------- Güvenlik başlıkları ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
